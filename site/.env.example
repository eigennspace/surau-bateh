# Env var untuk build-time fetch ke Sanity (lihat
# scripts/fetch-sanity-content.mjs, ADR 0006). Salin berkas ini jadi `.env`
# (di-gitignore, jangan pernah dikomit) dan isi nilainya.
#
# SANITY_PROJECT_ID/SANITY_DATASET adalah nilai publik (boleh dilihat siapa
# saja), SANITY_API_TOKEN adalah rahasia -- role Viewer/read-only sudah
# cukup untuk build (lihat .scratch/cms-migration-sanity/issues/01-setup-akun-project-sanity.md).
SANITY_PROJECT_ID=w5hrk5sv
SANITY_DATASET=production
SANITY_API_TOKEN=
