{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/surau/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans|Amiri))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans, Amiri."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArabicVerse'] > JSXAttribute > JSXIdentifier[name!=/^(?:arabic|translation|source|align|tone|style|key|ref|className|style|children)$/]",
        "message": "<ArabicVerse> doesn't accept that prop. Declared props: arabic, translation, source, align, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArabicVerse'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|right)$/]",
        "message": "<ArabicVerse> align must be one of 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArabicVerse'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sand|dark|brand)$/]",
        "message": "<ArabicVerse> tone must be one of 'sand' | 'dark' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|accent|active|solid)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'brand' | 'accent' | 'active' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|short|key|ref|className|style|children)$/]",
        "message": "<BottomBarItem> doesn't accept that prop. Declared props: label, icon, short."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|icon|iconPosition|fullWidth|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, tone, size, icon, iconPosition, fullWidth, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|accent|secondary|ghost|dark)$/]",
        "message": "<Button> tone must be one of 'primary' | 'accent' | 'secondary' | 'ghost' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Button> iconPosition must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|padding|interactive|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, padding, interactive, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|sand|brand|dark|calm)$/]",
        "message": "<Card> tone must be one of 'default' | 'sand' | 'brand' | 'dark' | 'calm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|checked|defaultChecked|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, description, checked, defaultChecked, onChange, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|description|children|footer|onClose|width|inline|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, description, children, footer, onClose, width, inline."
      },
      {
        "selector": "JSXOpeningElement[name.name='DonationProgress'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|collected|target|currency|deadline|style|key|ref|className|style|children)$/]",
        "message": "<DonationProgress> doesn't accept that prop. Declared props: title, collected, target, currency, deadline, style."
      },
